      },
      "references": [
        {
          "id": "GHSA-px8p-9vwx-vf98",
          "source": {
            "name": "GitHub Advisory Database",
            "url": "https://github.com/advisories/GHSA-px8p-9vwx-vf98"
          }
        }
      ],
      "ratings": [
        {
          "source": {
            "name": "GitHub Advisory Database"
          },
          "severity": "medium"
        }
      ],
      "description": "fflate unzipSync can enter an infinite loop when parsing malformed ZIP64 archives (denial of service; fixed in fflate 0.8.3).",
      "advisories": [
        {
          "title": "GHSA-px8p-9vwx-vf98",
          "url": "https://github.com/advisories/GHSA-px8p-9vwx-vf98"
        }
      ],
      "analysis": {
        "state": "not_affected",
        "justification": "code_not_present",
        "detail": "jsPDF 4.2.1 compiles in only fflate's zlib compression code. unzipSync and the ZIP/ZIP64 reader are not in jspdf.umd.min.js: the build checks that none of fflate's ZIP signatures or ZIP error message occur in it. The app never reads ZIP files."
      },
      "affects": [
        {
          "ref": "pkg:npm/fflate@0.8.1"
        }
      ]
    }
  ]
